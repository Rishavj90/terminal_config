{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",

  "palette": {
    "white": "#FFFFFF",
    "purple": "#9A348E",
    "pink": "#DA627D",
    "orange": "#FCA17D",
    "blue": "#86BBD8",
    "dark_blue": "#33658A",
    "green": "#4CAF50",
    "red": "#E53935"
  },

  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [

        {
          "type": "session",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "foreground": "p:white",
          "background": "p:purple",
          "template": " {{ .UserName }} "
        },

        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:white",
          "background": "p:pink",
          "options": {
            "style": "folder"
          },
          "template": " \uf07b {{ .Path }} "
        },

        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:white",
          "background": "p:orange",
          "template": " \ue725 {{ .HEAD }}{{ if .Working.Changed }} *{{ end }}{{ if .Staging.Changed }} +{{ end }} "
        },

        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:white",
          "background": "p:blue",
          "template": " \ue718 {{ .Full }} "
        },

        {
          "type": "status",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:white",
          "background": "p:red",
          "template": " ✘ {{ .Code }} "
        },

        {
          "type": "time",
          "style": "diamond",
          "foreground": "p:white",
          "background": "p:dark_blue",
          "trailing_diamond": "\ue0b0",
          "options": {
            "time_format": "15:04"
          },
          "template": "  {{ .CurrentDate | date .Format }} "
        }

      ]
    }
  ],

  "final_space": true,
  "version": 4
}