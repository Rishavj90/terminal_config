{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "kitty",
        "source": "~/Pictures/fastfetch.jpeg",
        "width": 30,
        "height": 15,
        "padding": {
            "right": 4
        }
    },

    "display": {
        "separator": "⋮",
        "color": {
            "keys": "#ff75ca",
            "title": "cyan"
        }
    },

    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk"
    ]
}